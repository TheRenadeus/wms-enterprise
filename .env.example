# Variables usadas por docker-compose. Copia a `.env` y rellena.
DB_USER=admin
DB_PASS=cambiar-por-password-fuerte
DB_NAME=wms_db
# Genera con: openssl rand -hex 32
JWT_SECRET=genera-un-secreto-aleatorio-de-64-hex
# En producción restringe el origen (ej: https://tudominio.com) en vez de *.
ALLOWED_ORIGIN=*
LOAD_TEST=0
