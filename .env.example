# Variables usadas por docker-compose. Copia este archivo a `.env` y rellena con tus valores.
# El `.env` real está en .gitignore: nunca lo subas al repositorio.

# ── Base de datos ────────────────────────────────────────────────
DB_USER=admin
DB_PASS=cambiar-por-password-fuerte
DB_NAME=wms_db

# ── Seguridad ────────────────────────────────────────────────────
# Genera uno con: openssl rand -hex 32   (obligatorio: sin él la API no arranca)
JWT_SECRET=genera-un-secreto-aleatorio-de-64-hex
# Opcional: secreto de los tokens del portal de clientes (si falta, se deriva de JWT_SECRET).
PORTAL_SECRET=

# Contraseña inicial del usuario 'admin'. Si la dejas vacía, el backend genera una aleatoria al primer
# arranque y la muestra una sola vez en su consola (docker compose logs wms-api). Cámbiala al ingresar.
SEED_ADMIN_PASSWORD=
# Contraseña del usuario 'demo' (solo fuera de producción; vacía = aleatoria, igual que admin).
SEED_DEMO_PASSWORD=

# Opcional: cuenta SUPERADMIN fija que se re-crea si falta (p. ej. tras formatear la base).
# SUPERADMIN_HASH es un hash bcrypt, nunca la contraseña en texto plano. Genera uno desde backend/ con:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'tu-contraseña'
SUPERADMIN_USER=
SUPERADMIN_HASH=
SUPERADMIN_FULLNAME=

# ── Red ──────────────────────────────────────────────────────────
# En producción restringe el origen (ej: https://tudominio.com) en vez de *.
ALLOWED_ORIGIN=*
LOAD_TEST=0
