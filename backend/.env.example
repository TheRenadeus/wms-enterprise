# Plantilla de variables de entorno del backend WMS.
# Copia este archivo a `.env` y rellena con valores reales.
# NUNCA comitees el `.env` con secretos reales (ya está en .gitignore).

# ── Base de datos ────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=admin
DB_PASS=cambiar-por-password-fuerte
DB_NAME=wms_db

# ── Seguridad ────────────────────────────────────────────────────
# Genera uno nuevo con:  openssl rand -hex 32
JWT_SECRET=genera-un-secreto-aleatorio-de-64-hex
# NODE_ENV=production aborta el arranque si JWT_SECRET no está definido.
NODE_ENV=production

# ── Integraciones (opcionales) ───────────────────────────────────
# Clave de Anthropic. Manténla solo en el entorno, nunca en el código.
ANTHROPIC_API_KEY=
# Token de ngrok para el túnel público.
NGROK_AUTHTOKEN=

# ── Red ──────────────────────────────────────────────────────────
PORT=3000
# Restringe el origen permitido de CORS en producción (en vez de *).
ALLOWED_ORIGIN=
