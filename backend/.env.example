# Plantilla de variables de entorno del backend WMS.
# Copia este archivo a `.env` y rellena con valores reales.
# NUNCA comitees el `.env` con secretos reales (ya está en .gitignore).

# ── Base de datos ────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=admin
DB_PASS=cambiar-por-password-fuerte
DB_NAME=wms_db

# ── Seguridad ────────────────────────────────────────────────────
# Genera uno nuevo con:  openssl rand -hex 32
JWT_SECRET=genera-un-secreto-aleatorio-de-64-hex
# NODE_ENV=production aborta el arranque si JWT_SECRET no está definido.
NODE_ENV=production
# Opcional: secreto de los tokens del portal de clientes (si falta, se deriva de JWT_SECRET).
PORTAL_SECRET=

# Contraseña inicial de 'admin' y de 'demo' (este último solo fuera de producción). Vacías = el backend
# genera una aleatoria al primer arranque y la muestra una sola vez en la consola.
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
# Cuenta SUPERADMIN fija opcional (SUPERADMIN_HASH = hash bcrypt, nunca la contraseña en texto plano).
SUPERADMIN_USER=
SUPERADMIN_HASH=
SUPERADMIN_FULLNAME=

# ── Integraciones (opcionales) ───────────────────────────────────
# Clave de Anthropic. Manténla solo en el entorno, nunca en el código.
ANTHROPIC_API_KEY=
# Token de ngrok para el túnel público.
NGROK_AUTHTOKEN=

# ── Red ──────────────────────────────────────────────────────────
PORT=3000
# Restringe el origen permitido de CORS en producción (en vez de *).
ALLOWED_ORIGIN=
